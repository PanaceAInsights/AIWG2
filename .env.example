# ACD Research Intelligence Platform — Environment Variables
# Copy this file to .env and fill in your values.

# ── OpenAlex (no key required — polite pool) ──────────────────────────────
OPENALEX_EMAIL=your@email.com

# ── Anthropic (for AI chatbot + LLM disambiguation) ──────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Dashboard ─────────────────────────────────────────────────────────────
DASH_DEBUG=false
PORT=8050

# ── Pipeline ──────────────────────────────────────────────────────────────
# Max concurrent OpenAlex requests (default: 5)
OPENALEX_CONCURRENCY=5

# LLM disambiguation model (default: claude-haiku-4-5)
LLM_DISAMBIG_MODEL=claude-haiku-4-5
